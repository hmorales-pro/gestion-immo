# For shared hosting where the document root cannot point to /public:
# every request is served from /public, so .env, vendor/, storage/… stay unreachable.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(\.well-known/.*)$ public/$1 [L]
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

<FilesMatch "^\.">
    Require all denied
</FilesMatch>
