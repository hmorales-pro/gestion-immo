# ImmoBooking — configuration type pour un hébergement mutualisé (Hostinger, o2switch, OVH…)
# Copiez ce fichier en .env puis remplissez les valeurs entre crochets.

APP_NAME=ImmoBooking
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://[votre-domaine.fr]
APP_TIMEZONE=Europe/Paris
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

LOG_CHANNEL=daily
LOG_LEVEL=warning

# MySQL fourni par l'hébergeur (ou DB_CONNECTION=sqlite sans les lignes suivantes)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=[base]
DB_USERNAME=[utilisateur]
DB_PASSWORD=[mot-de-passe]

# Pas de worker sur un mutualisé : les e-mails partent immédiatement.
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
CACHE_STORE=file

# E-mails via Brevo (ou MAIL_MAILER=smtp avec le SMTP de l'hébergeur)
MAIL_MAILER=brevo
BREVO_API_KEY=[xkeysib-...]
MAIL_FROM_ADDRESS="visites@[votre-domaine.fr]"
MAIL_FROM_NAME="${APP_NAME}"

# SMS : log (aucun envoi) | brevo | twilio | vonage
SMS_DRIVER=log
BREVO_SMS_SENDER=ImmoBook

# Site vitrine + démo publique : uniquement pour le site officiel.
# Pour l'installation d'une agence, laissez false : "/" ouvre directement l'administration.
IMMOBOOKING_WEBSITE=false
IMMOBOOKING_DEMO=false
IMMOBOOKING_SITE_URL=
IMMOBOOKING_LEGAL_EDITOR=
IMMOBOOKING_LEGAL_ADDRESS=
IMMOBOOKING_LEGAL_EMAIL=
IMMOBOOKING_LEGAL_SIRET=
IMMOBOOKING_LEGAL_PUBLISHER=
IMMOBOOKING_LEGAL_HOST=
